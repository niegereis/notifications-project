{
  "name": "notification-gateway",
  "version": "0.1.0",
  "description": "Gateway de notificações: recebe pedidos, roteia por canal e entrega com retry",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "typeorm": "node --import @swc-node/register/esm-register ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "db:generate": "npm run typeorm -- migration:generate",
    "db:run": "npm run typeorm -- migration:run",
    "db:revert": "npm run typeorm -- migration:revert",
    "db:seed": "node --import @swc-node/register/esm-register src/database/seed.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "pretest:e2e": "DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://notifications:notifications@localhost:5432/notifications_test}\" npm run db:run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/typeorm": "^12.0.1",
    "amqplib": "^2.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.18.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^4.1.2"
  },
  "allowScripts": {
    "@swc/core@1.16.2": true,
    "fsevents@2.3.3": true
  }
}
