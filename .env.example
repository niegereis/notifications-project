# Copie para .env (`cp .env.example .env`) antes de rodar `docker compose up`.
# Os valores abaixo são os defaults usados pelo compose — só mude se precisar.

# --- Postgres ---
POSTGRES_USER=notifications
POSTGRES_PASSWORD=notifications
POSTGRES_DB=notifications
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_USER=notifications
RABBITMQ_PASSWORD=notifications
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PROMETHEUS_PORT=15692

# --- E-mail (Mailpit local: SMTP em 1025, caixa de entrada em http://localhost:8025) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM="Notification Gateway <no-reply@notifications.local>"

# --- API ---
API_PORT=3000

# --- Worker (só o /metrics; o processo em si não serve a API) ---
WORKER_METRICS_PORT=9464

# --- Observabilidade ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030

# --- Mini-painel ---
PANEL_PORT=8080
# Chave que o painel usa por padrão (serviço billing). Pode trocar na UI.
PANEL_API_KEY=sk_a78dff27f6c483432ca937d9eceeeb92ebc0a8dbc8c6cb36

# Serviços autorizados a chamar o gateway, no formato `servico:chave`, separados
# por vírgula. As chaves abaixo são de desenvolvimento: gere as suas com
# `openssl rand -hex 32` e nunca reaproveite estas em ambiente real.
API_KEYS=billing:sk_a78dff27f6c483432ca937d9eceeeb92ebc0a8dbc8c6cb36,crm:sk_89a68d0cdddd1da187530592708a1183bf04cbc87c2c9f98

# --- Usado apenas ao rodar a API fora do Docker (npm run start:dev) ---
# Dentro do compose esses valores vêm do próprio docker-compose.yml.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://notifications:notifications@localhost:5432/notifications
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://notifications:notifications@localhost:5672
SMTP_HOST=localhost
SMTP_PORT=1025
# Porta do /metrics do worker quando ele roda fora do Docker.
METRICS_PORT=9464
# API_KEYS e MAIL_FROM também são lidos aqui quando a API roda fora do Docker.

# --- Idempotência e rate limit (API) ---
# TTL da Idempotency-Key no Redis (default 24h). Sem o header, cada POST cria
# um pedido novo.
IDEMPOTENCY_TTL_SECONDS=86400
# Teto de pedidos por destinatário+canal dentro da janela (não por serviço).
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- SMS (Twilio). Sem estas três, o worker simula o SMS no log. ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+5511999000000

# --- Push (FCM HTTP v1). Sem estas três, o worker simula o push no log. ---
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# --- Webhook de desfecho. Assina X-Webhook-Signature (mínimo 16 caracteres). ---
# WEBHOOK_SECRET=
